# Development only: lets unprivileged users open the sensor so the libfprint
# examples can run without sudo. Remove it once development is done: with it,
# any local process can talk to the sensor and, since the PSK is the public
# all-zero one, decrypt fingerprint images. fprintd runs as root and does not
# need this rule.
#
# Install:  sudo cp 70-goodix5503.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# Remove:   sudo rm /etc/udev/rules.d/70-goodix5503.rules && sudo udevadm control --reload
SUBSYSTEM=="usb", ATTRS{idVendor}=="27c6", ATTRS{idProduct}=="5503", MODE="0666", TAG+="uaccess"
